{
  "name": "tounar-bang-ni-li",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tounar 帮你理：投递线索整理与进度追踪",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists .env server/src/index.js",
    "dev": "APP_ENV=development node --env-file-if-exists .env --watch server/src/index.js",
    "test": "node --test --test-concurrency=1 server/test/*.test.js",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "test:web": "node tests/e2e/run-web-e2e.mjs",
    "local:acceptance": "node server/scripts/local-acceptance.js",
    "local:stop": "node server/scripts/local-stop.js",
    "otp:latest": "node server/scripts/latest-otp.js",
    "probe:site": "node tools/probe-site.mjs",
    "probe:llm": "node --env-file-if-exists .env tools/probe-llm.mjs",
    "plugin:tryrun": "node tools/tryrun-plugin.mjs",
    "remind": "node --env-file-if-exists .env server/scripts/run-reminders.js",
    "mail:sync": "node --env-file-if-exists .env server/scripts/run-mail-sync.js",
    "test:plugin-acceptance": "node tests/e2e/plugin-acceptance.mjs",
    "test:plugin-backend": "node tests/e2e/backend-access.mjs",
    "test:toast": "node tests/e2e/toast-feedback.mjs",
    "test:self-page": "node tests/e2e/self-page-guard.mjs",
    "audit:self-captures": "node server/scripts/audit-self-captures.js",
    "test:career-ai": "node tests/e2e/career-ai.mjs",
    "test:intake": "node --test --test-concurrency=1 server/test/intake-workflow.test.js server/test/plugin-auto-intake.test.js",
    "eval:intake": "node --env-file-if-exists .env tools/eval-intake.mjs",
    "mail:selftest": "node server/scripts/mail-selftest.js start",
    "mail:selftest:stop": "node server/scripts/mail-selftest.js stop",
    "mail:selftest:status": "node server/scripts/mail-selftest.js status",
    "test:mail-admin": "node tests/e2e/mail-admin.mjs",
    "build:plugin": "node tools/build-beta-plugin.mjs",
    "init:beta": "node server/scripts/init-beta.mjs"
  },
  "dependencies": {
    "@tencent-ai/workbuddy-cloud-sdk": "^0.1.4-dev.ca27990.202610161713",
    "imapflow": "^2.5.9",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
