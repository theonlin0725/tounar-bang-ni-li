{
  "manifest_version": 3,
  "name": "Tounar 帮你理 · 投递线索采集",
  "version": "0.2.3",
  "description": "在用户授权的招聘页面识别岗位详情、投递成功与申请状态，只上传必要的结构化线索。",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "Tounar 帮你理",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/adapters.js", "content/tracker.js"],
      "matches": ["*://*/*"]
    }
  ]
}
