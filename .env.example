# 复制为 .env 后按需修改；.env 不会进 Git。
# 所有值都有默认值，缺了也能跑（会退回到开发模式）。

# 端口
PORT=4310

# 内测准入白名单（逗号分隔，大小写不敏感）。不填则用默认测试邮箱。
ALLOWED_EMAILS=demo@tounar.local,peer@tounar.local

# 发信：不配 SMTP_URL 就是开发模式，邮件写到 data/outbox/ 目录，不会真的发出去。
# 配了才走真实发信，例如 QQ 邮箱：SMTP_URL=smtp://你的QQ号@qq.com:授权码@smtp.qq.com:465
# SMTP_URL=
# MAIL_FROM=Tounar 帮你理 <no-reply@example.com>

# WorkBuddy 云服务（免密钥大模型，用于规则解析失败时的兜底识别）。
# 不配则自动回退纯规则解析，功能不受影响。值在开通云服务后由激活流程给出。
# CLOUD_ENDPOINT=
# CLOUD_PUBLISHABLE_KEY=
# CLOUD_LLM_ENABLED=true

# 提醒批次时间（北京时间）
REMINDER_HOUR=8
REMINDER_MINUTE=0

# 已冻结决策的默认值（D01-D12 于 2026-10-22 拍板，一般无需覆盖）
# D03：看过未投 30 天自动归档（保留可查、不计累计投递）
# BROWSE_ARCHIVE_DAYS=30
# D05：终态允许人工纠错（必填原因 + 全程留痕）
# D05_ALLOW_TERMINAL_CORRECTION=true
# D08：邮件终态置信度 >= 0.9 自动判定，低于进待确认；待确认每 15 天随邮件汇总
# AUTO_TERMINAL_FROM_MAIL=true
# AUTO_TERMINAL_CONFIDENCE=0.9
# REVIEW_DIGEST_DAYS=15
# D12：三项保持严格（缺字段拒绝入库），插件自动采集/自动填充为主路径
# D12_ALLOW_MISSING_JD=false
# D12_ALLOW_MISSING_LINK=false
# D12_ALLOW_MISSING_APPLIED_AT=false
