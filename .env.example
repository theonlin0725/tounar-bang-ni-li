# 复制为 .env 后按需修改；.env 不会进 Git。
# 未配置 SMTP 时默认写本地 outbox；已配置 SMTP_URL 时默认真实发信。
# 本地验证如需强制只写文件，显式设置 MAIL_MODE=outbox。

# 公共运行配置（默认值见 server/src/config.js）
# HOST=127.0.0.1  # 仅本机监听；未设置时代码默认 0.0.0.0
# DATA_DIR=./data
# DB_PATH=./data/tounar.sqlite
# APP_BASE_URL=http://127.0.0.1:4310
# ENABLE_SCHEDULER=true
# MAIL_MODE=outbox

# 端口
PORT=4310
# 发布版本标识（健康接口可识别；WorkBuddy 发布时设置）
APP_VERSION=20261102-beta4
APP_ENV=production

# 共享邀请码最多激活的新邮箱数；邀请码由 server/scripts/init-beta.mjs 生成
BETA_INVITE_MAX_USES=10
# 初始化脚本默认生成关闭状态；平台持久化/备份验收后再执行 --open
# 调度：实例数/休眠未确认前不要同时启用进程内与外部调度
# ENABLE_SCHEDULER=false
# 自测登录和验证码回显在生产必须关闭
ENABLE_SELFTEST_LOGIN=false


# 内测准入（生产 beta）：静态白名单只用于旧账号/开发隔离；新用户靠邀请码。
# 生产请设为空或只放明确保留的旧账号；管理员用 ADMIN_EMAILS 独立配置。
ALLOWED_EMAILS=

# 发信：不配 SMTP_URL 就是开发模式，邮件写到 data/outbox/ 目录，不会真的发出去。
# 配了才走真实发信，例如 QQ 邮箱：SMTP_URL=smtp://你的QQ号@qq.com:授权码@smtp.qq.com:465
# SMTP_URL=
# MAIL_FROM=Tounar 帮你理 <no-reply@example.com>

# WorkBuddy 云服务（免密钥大模型，用于规则解析失败时的兜底识别）。
# 不配则使用规则解析，不提供云端兜底。值在开通云服务后由激活流程给出。
# CLOUD_ENDPOINT=
# CLOUD_PUBLISHABLE_KEY=
# CLOUD_LLM_ENABLED=true

# 云端 SQLite 快照持久化：生产启用前必须已创建受保护的快照表/RPC，
# 并保持 MASTER_KEY、INTERNAL_TICK_TOKEN、stream 不变；只支持单写入实例。
# CLOUD_PERSISTENCE_ENABLED=false
# CLOUD_SNAPSHOT_STREAM=bangnili-beta-v1

# 数据抓取插件层：QQ IMAP（授权码通过网页绑定，不在此填写）
# IMAP_HOST=imap.qq.com
# IMAP_PORT=993
# IMAP_CONNECT_TIMEOUT_MS=20000
# MAIL_SYNC_MINUTES=25

# 提醒批次时间（北京时间）
REMINDER_HOUR=8
REMINDER_MINUTE=0

# 已冻结决策的默认值（D01-D12 于 2026-10-22 拍板，一般无需覆盖）
# D03：看过未投 30 天自动归档（保留可查、不计累计投递）
# BROWSE_ARCHIVE_DAYS=30
# D05：终态允许人工纠错（必填原因 + 全程留痕）
# D05_ALLOW_TERMINAL_CORRECTION=true
# D08：邮件终态置信度 >= 0.9 自动判定，低于进待确认；待确认每 15 天随邮件汇总
# AUTO_TERMINAL_FROM_MAIL=true
# AUTO_TERMINAL_CONFIDENCE=0.9
# REVIEW_DIGEST_DAYS=15
# D12：三项保持严格（缺字段拒绝入库），插件自动采集/自动填充为主路径
# D12_ALLOW_MISSING_JD=false
# D12_ALLOW_MISSING_LINK=false
# D12_ALLOW_MISSING_APPLIED_AT=false

# 二期：总把握度 = 邮件分类置信度 × 匹配把握度（唯一候选才可自动更新）
# AUTO_PROGRESS_CONFIDENCE=0.8
# AUTO_TERMINAL_CONFIDENCE=0.9
# D12_ALLOW_MAIL_INFERRED_APPLIED_AT=true
# 笔试/面试后回看 7/14/关闭在网页提醒设置中选择，按用户保存，不是进程环境变量。

# 管理员：独立于邀请码，不占 10 个体验名额；生产必须配置。
# ADMIN_EMAILS=admin@example.com
# TEST_MAIL_RECIPIENTS=仅用于试发的邮箱,另一个测试邮箱
# ENABLE_MAIL_BUSINESS_TEST=false
# 仅本机管理员自测登录：默认 false；只有 APP_ENV=development、APP_BASE_URL 为
# 127.0.0.1/localhost、请求来自回环地址且邮箱在 ADMIN_EMAILS 时才回显验证码。
# 专用 mail:selftest 启动器会临时开启；生产禁止开启。
# ENABLE_SELFTEST_LOGIN=false

# 简历与 AI 岗位分析（复用 CLOUD_ENDPOINT/CLOUD_PUBLISHABLE_KEY；不配置则接口明确失败）
# AI_LLM_TIMEOUT_MS=60000
# AI_MAX_JOBS=12
# 推荐：服务端配置 OpenAI 兼容模型网关（不要把 key 放前端/插件）
# AI_API_URL=https://模型网关/v1
# AI_API_KEY=服务端密钥
# AI_MODEL=模型名
# AI_PROVIDER=openai_compatible
# npm run mail:selftest 使用固定自测副本（data/mail-selftest-profile.json 指向的
# data/mail-selftest）；若未显式配置，管理员取 ALLOWED_EMAILS 第一项，
# 测试收件人取 ALLOWED_EMAILS 全部邮箱；启动时打印配置，不会自动发信。
# MAIL_SELFTEST_PORT=4311

# Jev / TypeSafe：招聘进展判断模型
# 将你的 Jev API key 填在 JEV_API_KEY= 后，不要加 Bearer 前缀。
# JEV_API_URL 是完整判断接口地址；与现有 AI_API_* 配置分别使用。
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest
# 自动入账工作流：三项凭据齐全时默认开启；测试/离线可显式关闭。
# AUTO_INTAKE_ENABLED=true
# AUTO_INTAKE_MIN_PROGRESS=0.72
# AUTO_INTAKE_MIN_EVIDENCE=0.65
# AUTO_INTAKE_MIN_STATUS=0.60
# AUTO_INTAKE_MIN_CANDIDATE=0.60
# AUTO_INTAKE_MIN_TERMINAL=0.85
# AUTO_INTAKE_RETRY_MINUTES=5
# JEV_TIMEOUT_MS=30000
# 可选：本机到 TypeSafe Jev 被地区限制（HTTP 451）时，通过 Dify Cloud 工作流调用真实 Jev。
# 仅填 URL/Key；不要提交真实 key。工作流需使用本仓库 docs/dify 的 DSL 并填入 Jev key。
# DIFY_API_URL=https://api.dify.ai/v1
# DIFY_API_KEY=
# DIFY_USER_ID=tounar-confirm
# DIFY_TIMEOUT_MS=30000
